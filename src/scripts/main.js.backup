// @ts-check
/** @type {Window & { app: null}} */
const w = /** @type {any} */ (window);
interface AppState {
    /** @type {HTMLDivElement | null} */
    chat: null,
    /** @type {HTMLDivElement | null} */
    welcome: null,
    /** @type {HTMLTextAreaElement | null} */
    input: null,
    /** @type {HTMLButtonElement | null} */
    sendBtn: null
};

window.onload = function main() {
    const app = window.app;
    app.chat = document.getElementById("chat");
    app.welcome = document.getElementById("welcome");
    app.input = document.getElementById("input");
    app.sendBtn = document.getElementById("send");
    app.input.addEventListener("input", autosize);
    app.input.addEventListener("keydown", (e) => {
        if (e.key === "Enter" && !e.shiftKey) {
            e.preventDefault();
            send();
        }
    });
    app.sendBtn.addEventListener("click", send);
    autosize();
};

