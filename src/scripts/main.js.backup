function autosize() {
    const app = window.app;
    app.input.style.height = "auto";
    app.input.style.height = Math.min(app.input.scrollHeight, 200) + "px";
    app.sendBtn.disabled = app.input.value.trim() === "";
}

function censor(text, badWords) {
    const escape = (s) => s.replace(/[.*+?^${}()|[\]\\]/g, "\\$&");
    const pattern = new RegExp(`\\b(${badWords.map(escape).join("|")})\\b`, "gi");
    return text.replace(pattern, (match) => "*".repeat(match.length));
}

function send() {
    const app = window.app;
    var text = app.input.value.trim();
    text = censor(text, badWords)
    if (!text) return;
    if (app.welcome) app.welcome.remove();
    const el = document.createElement("div");
    el.className = "msg user";
    el.textContent = text
    app.chat.appendChild(el);
    app.input.value = "";
    autosize();
    app.chat.scrollTop = app.chat.scrollHeight;
}

